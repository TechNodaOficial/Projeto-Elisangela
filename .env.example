# ── .env (dia a dia) ─────────────────────────────────────────────────────────
# Banco local. Use a URL TCP (postgres://...) exibida por `npx prisma dev -n painel-festas`.
DATABASE_URL="postgres://postgres:postgres@localhost:51218/template1?sslmode=disable"

# Banco "sombra" do prisma dev (porta seguinte), usado só pelo `prisma migrate dev`.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51219/template1?sslmode=disable"

# Usuário local criado pelo `npm run db:seed`. Senha com pelo menos 10 caracteres.
SEED_EMAIL="elisangela@exemplo.com"
SEED_NOME="Elisangela"
SEED_SENHA=""

# Blob store (privado) da Vercel, para a planta do salão. Copie da aba ".env.local" do store.
BLOB_READ_WRITE_TOKEN=""

# Contato da Elisangela no convite (ícones de Instagram e WhatsApp). Vazio = não aparece.
# Coloque também na Vercel (Settings → Environment Variables).
CONTATO_INSTAGRAM=""
CONTATO_WHATSAPP=""

# ── .env.producao (só para os scripts *:prod) ────────────────────────────────
# Crie um arquivo separado .env.producao (ignorado pelo git) com:
#
# DATABASE_URL="postgresql://...@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://...@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"
# SEED_EMAIL="email real da Elisangela"
# SEED_NOME="Elisangela"
# SEED_SENHA="senha real, 10+ caracteres"
#
# Na Vercel, só DATABASE_URL e DATABASE_URL_UNPOOLED (a integração Neon já cria). Nunca SEED_*.

# ── Variáveis só da produção (Vercel → Settings → Environment Variables) ─────
# Segredo do cron diário de limpeza (LGPD). A Vercel o envia sozinha nas chamadas do cron.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=""
#
# Quem cuida dos dados e como falar com ela, na página /privacidade dos convidados.
# PRIVACIDADE_RESPONSAVEL="Elisangela Sobrenome (Elisangela Eventos)"
# PRIVACIDADE_CONTATO="contato@exemplo.com.br ou (19) 99999-9999"
#
# BLOB_READ_WRITE_TOKEN: criado sozinho ao conectar o Blob store ao projeto.
