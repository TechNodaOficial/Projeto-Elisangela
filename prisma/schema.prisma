generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  nome      String
  senhaHash String
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)
  sessoes   Sessao[]

  @@map("usuarios")
}

model Sessao {
  id        String   @id @default(cuid())
  // SHA-256 do token que fica no cookie. O token em si nunca é salvo.
  tokenHash String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime @db.Timestamptz(3)
  criadoEm  DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("sessoes")
}

// Tentativas de login que falharam, para o rate limit.
// chave = "ip:<endereço>" ou "email:<email>".
model TentativaLogin {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@index([chave, criadoEm])
  @@map("tentativas_login")
}

model Festa {
  id           String           @id @default(cuid())
  titulo       String
  // Data e horário juntos, como instante (timestamptz). A exibição converte para o fuso de São Paulo.
  dataHora     DateTime         @db.Timestamptz(3)
  localNome    String
  endereco     String
  traje        String?
  observacoes  String?
  criadoEm     DateTime         @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime         @updatedAt @db.Timestamptz(3)
  convidados   Convidado[]
  fornecedores Fornecedor[]
  mesas        Mesa[]
  cronograma   ItemCronograma[]

  @@index([dataHora])
  @@map("festas")
}

enum StatusRsvp {
  PENDENTE
  CONFIRMADO
  RECUSADO
}

model Convidado {
  id            String      @id @default(cuid())
  festaId       String
  festa         Festa       @relation(fields: [festaId], references: [id], onDelete: Cascade)
  nome          String
  telefone      String?
  // Vai no link do convite (/c/[tokenConvite]).
  tokenConvite  String      @unique
  // Vai dentro do QR Code. Separado do token do convite para que uma foto do QR
  // não permita alterar a resposta do convidado.
  codigoCheckin String      @unique
  rsvp          StatusRsvp  @default(PENDENTE)
  respondidoEm  DateTime?   @db.Timestamptz(3)
  presenteEm    DateTime?   @db.Timestamptz(3)
  // Reservado para acompanhantes (fora do MVP): o acompanhante aponta para o titular.
  titularId     String?
  titular       Convidado?  @relation("Acompanhantes", fields: [titularId], references: [id], onDelete: Cascade)
  acompanhantes Convidado[] @relation("Acompanhantes")
  // Mesa onde o convidado vai sentar. Remover a mesa deixa o convidado sem mesa.
  mesaId        String?
  mesa          Mesa?       @relation(fields: [mesaId], references: [id], onDelete: SetNull)
  criadoEm      DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime    @updatedAt @db.Timestamptz(3)

  @@index([festaId])
  @@index([titularId])
  @@index([mesaId])
  @@map("convidados")
}

model Fornecedor {
  id            String           @id @default(cuid())
  festaId       String
  festa         Festa            @relation(fields: [festaId], references: [id], onDelete: Cascade)
  nome          String
  servico       String
  telefone      String?
  // Em centavos, para não ter erro de arredondamento. Vazio = valor ainda não definido.
  valorCentavos Int?
  pago          Boolean          @default(false)
  cronograma    ItemCronograma[]
  criadoEm      DateTime         @default(now()) @db.Timestamptz(3)
  atualizadoEm  DateTime         @updatedAt @db.Timestamptz(3)

  @@index([festaId])
  @@map("fornecedores")
}

model Mesa {
  id           String      @id @default(cuid())
  festaId      String
  festa        Festa       @relation(fields: [festaId], references: [id], onDelete: Cascade)
  nome         String
  lugares      Int
  convidados   Convidado[]
  criadoEm     DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm DateTime    @updatedAt @db.Timestamptz(3)

  @@index([festaId])
  @@map("mesas")
}

model ItemCronograma {
  id               String      @id @default(cuid())
  festaId          String
  festa            Festa       @relation(fields: [festaId], references: [id], onDelete: Cascade)
  // "HH:MM" no horário de São Paulo. Horários antes das 06:00 contam como madrugada (fim da festa).
  hora             String
  atividade        String
  // Responsável: um fornecedor cadastrado ou um texto livre (ex.: "Cerimonialista").
  fornecedorId     String?
  fornecedor       Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  responsavelTexto String?
  criadoEm         DateTime    @default(now()) @db.Timestamptz(3)
  atualizadoEm     DateTime    @updatedAt @db.Timestamptz(3)

  @@index([festaId])
  @@map("itens_cronograma")
}
